---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/benchmarks/`, label: 'Benchmarks' },
  { href: `${base}/recipes/`, label: 'Recipes' },
  { href: `${base}/deploy-with-agent/`, label: 'Agent prompt' },
  { href: `${base}/results/`, label: 'Results' },
  { href: `${base}/setup/`, label: 'Setup' },
  { href: `${base}/agents/`, label: 'Agents' },
  { href: `${base}/stack/`, label: 'Stack' },
];

const currentPath = Astro.url.pathname;
// enlace a la otra versión de idioma cuando existe (páginas *.es)
const BILINGUAL = ['benchmarks', 'recipes', 'deploy-with-agent', 'results', 'setup'];
const slug = currentPath.replace(base, '').replace(/^\/|\/$/g, '');
const isEs = slug.endsWith('.es');
const root = slug.replace(/\.es$/, '');
const langLink = BILINGUAL.includes(root) ? { href: `${base}/${root}${isEs ? '' : '.es'}/`, label: isEs ? 'English' : 'Español' } : null;
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-container">
    <a class="nav-brand" href={base}>
      <span>Local LLM Guide</span>
    </a>
    <ul class="nav-links">
      {
        links.map((link) => {
          const isActive =
            currentPath === link.href || currentPath === link.href.replace(/\/$/, '');
          return (
            <li>
              <a href={link.href} aria-current={isActive ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          );
        })
      }
      {langLink && <li><a href={langLink.href} hreflang={isEs ? 'en' : 'es'} lang={isEs ? 'en' : 'es'}>{langLink.label}</a></li>}
    </ul>
  </div>
</nav>
